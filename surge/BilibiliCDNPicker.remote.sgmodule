#!name=Bilibili CDN Picker
#!desc=B 站点播 DASH 媒体 CDN 测速与选择（v0.4.0，手动探索版）。用当前播放资源做 Range 实测，支持 HTTP 80 与 HTTPS 443，只改写后续 /upgcxcode/*.m4s 请求的主机与 Host。需开启 MITM 并信任证书；停用模块即恢复原生行为。
#!category=Bilibili
#!arguments=ENABLED:true,MODE:manual,REGION:SG,TARGET_MBPS:80,HISTORY_POLICY:conservative,CELLULAR_DISCOVERY:false,ROUTE_REVISION:default,PROBE_POLICY,DEBUG:false
#!arguments-desc=ENABLED 总开关；MODE=manual|adaptive（adaptive 需先完成生命周期实验）；REGION 为出口地区推荐表（SG/TW/HK/JP/AU/US/NONE）；TARGET_MBPS 为未知码率时的足够快目标；HISTORY_POLICY=conservative|optimistic；CELLULAR_DISCOVERY 允许蜂窝自动/完整探索；ROUTE_REVISION 在更换代理出口后修改以隔离历史；PROBE_POLICY 为测速使用的策略名（留空则按规则）；DEBUG 输出脱敏调试日志。

[General]
force-http-engine-hosts = %APPEND% bcp.test:80, upos-*.bilivideo.com:80, cn-*.bilivideo.com:80, ec-*.bilivideo.com:80, upos-*.akamaized.net:80

[Host]
bcp.test = 127.0.0.1

[Script]
BiliCDN-Web = type=http-request, pattern=^https?://bcp\.test(?::(?:80|443))?/, requires-body=true, max-size=16384, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/web-control.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Router = type=http-request, pattern=^(?:http://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::80)?|https://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::443)?)/upgcxcode/[^?#]+\.m4s\?, requires-body=false, debug={{{DEBUG}}}, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/request-router.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Observer = type=http-response, pattern=^(?:http://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::80)?|https://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::443)?)/upgcxcode/[^?#]+\.m4s\?, requires-body=false, debug={{{DEBUG}}}, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/response-observer.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Runner = type=cron, cronexp="*/15 * * * *", engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/discovery-runner.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Panel = type=generic, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/control-panel.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}&action=status"
BiliCDN-Explore = type=generic, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/control-panel.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}&action=full"
BiliCDN-Stop = type=generic, engine=webview, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/control-panel.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}&action=stop"
BiliCDN-Diagnostics = type=generic, engine=webview, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/control-panel.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}&action=status"
BiliCDN-Network = type=event, event-name=network-changed, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2810b3c9d0d00924477eea9199d5bad115acb3a7/surge/network-event.js

[Panel]
BiliCDN-Status = title="B站 CDN · 网页管理", content="Safari 打开 https://bcp.test · 管理、测速和实时进度", style=info, script-name=BiliCDN-Panel, update-interval=60

[MITM]
hostname = %APPEND% bcp.test, upos-*.bilivideo.com, cn-*.bilivideo.com, ec-*.bilivideo.com, upos-*.akamaized.net

#!name=Bilibili CDN Picker
#!desc=B 站点播 DASH 媒体 CDN 测速与选择（v0.3.1，手动探索版）。用当前播放资源做 Range 实测，只改写后续 /upgcxcode/*.m4s 请求的主机与 Host。需开启 MITM 并信任证书；停用模块即恢复原生行为。
#!category=Bilibili
#!arguments=ENABLED:true,MODE:manual,REGION:SG,TARGET_MBPS:80,HISTORY_POLICY:conservative,CELLULAR_DISCOVERY:false,ROUTE_REVISION:default,PROBE_POLICY,DEBUG:false
#!arguments-desc=ENABLED 总开关；MODE=manual|adaptive（adaptive 需先完成生命周期实验）；REGION 为出口地区推荐表（SG/TW/HK/JP/AU/US/NONE）；TARGET_MBPS 为未知码率时的足够快目标；HISTORY_POLICY=conservative|optimistic；CELLULAR_DISCOVERY 允许蜂窝自动/完整探索；ROUTE_REVISION 在更换代理出口后修改以隔离历史；PROBE_POLICY 为测速使用的策略名（留空则按规则）；DEBUG 输出脱敏调试日志。

[Script]
BiliCDN-Router = type=http-request, pattern=^https://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::443)?/upgcxcode/[^?#]+\.m4s\?, requires-body=false, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/a425c80fe70f216d05a7fefea3123824217e47af/surge/request-router.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Observer = type=http-response, pattern=^https://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::443)?/upgcxcode/[^?#]+\.m4s\?, requires-body=false, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/a425c80fe70f216d05a7fefea3123824217e47af/surge/response-observer.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Runner = type=cron, cronexp="*/15 * * * *", engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/a425c80fe70f216d05a7fefea3123824217e47af/surge/discovery-runner.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}"
BiliCDN-Panel = type=generic, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/a425c80fe70f216d05a7fefea3123824217e47af/surge/control-panel.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}&action=quick"
BiliCDN-Explore = type=generic, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/a425c80fe70f216d05a7fefea3123824217e47af/surge/control-panel.js, argument="enabled={{{ENABLED}}}&mode={{{MODE}}}&region={{{REGION}}}&targetMbps={{{TARGET_MBPS}}}&historyPolicy={{{HISTORY_POLICY}}}&cellularDiscovery={{{CELLULAR_DISCOVERY}}}&routeRevision={{{ROUTE_REVISION}}}&probePolicy={{{PROBE_POLICY}}}&debug={{{DEBUG}}}&action=full"
BiliCDN-Network = type=event, event-name=network-changed, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/a425c80fe70f216d05a7fefea3123824217e47af/surge/network-event.js

[Panel]
BiliCDN-Status = title="B站 CDN", content="点按刷新按钮：对当前播放资源运行快速选择", style=info, script-name=BiliCDN-Panel, update-interval=60
BiliCDN-Discovery = title="B站 CDN · 完整探索", content="点按刷新按钮：对当前视频运行完整探索（目标预算 100 MiB，建议仅在 Wi-Fi 下使用）", style=info, script-name=BiliCDN-Explore, update-interval=3600

[MITM]
hostname = %APPEND% upos-*.bilivideo.com, cn-*.bilivideo.com, ec-*.bilivideo.com, upos-*.akamaized.net

#!name=Bilibili CDN Picker Diagnostic
#!desc=B 站点播 DASH 媒体 CDN 测速与选择（v0.4.1，手动探索版）。用当前播放资源做 Range 实测，支持 HTTP 80 与 HTTPS 443，只改写后续 /upgcxcode/*.m4s 请求的主机与 Host。需开启 MITM 并信任证书；停用模块即恢复原生行为。
#!category=Bilibili

[General]
force-http-engine-hosts = %APPEND% bcp.test:80, upos-*.bilivideo.com:80, cn-*.bilivideo.com:80, ec-*.bilivideo.com:80, upos-*.akamaized.net:80

[Host]
bcp.test = 127.0.0.1

[Script]
BiliCDN-Web = type=http-request, pattern=^https?://bcp\.test(?::(?:80|443))?/, requires-body=true, max-size=16384, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/web-control.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true
BiliCDN-Router = type=http-request, pattern=^(?:http://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::80)?|https://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::443)?)/upgcxcode/[^?#]+\.m4s\?, requires-body=false, debug=true, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/request-router.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true
BiliCDN-Observer = type=http-response, pattern=^(?:http://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::80)?|https://(?:(?:upos|cn|ec)-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+\.akamaized\.net)(?::443)?)/upgcxcode/[^?#]+\.m4s\?, requires-body=false, debug=true, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/response-observer.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true
BiliCDN-Runner = type=cron, cronexp="*/15 * * * *", engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/discovery-runner.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true
BiliCDN-Panel = type=generic, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/control-panel.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true&action=status
BiliCDN-Explore = type=generic, engine=webview, timeout=75, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/control-panel.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true&action=full
BiliCDN-Stop = type=generic, engine=webview, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/control-panel.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true&action=stop
BiliCDN-Diagnostics = type=generic, engine=webview, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/control-panel.js, argument=enabled=true&mode=manual&region=SG&targetMbps=80&historyPolicy=conservative&routeRevision=default&probePolicy=&debug=true&action=status
BiliCDN-Network = type=event, event-name=network-changed, engine=jsc, timeout=5, script-path=https://raw.githubusercontent.com/panelatta/bilibili-cdn-picker/2524abcf6d6e706b3170d45b851bcdb9e55835a0/surge/network-event.js

[Panel]
BiliCDN-Loaded = title="BCP v0.4.1 已加载", content="静态安装标记。Safari 打开 https://bcp.test 管理测速和查看实时进度。", style=info
BiliCDN-Status = title="B站 CDN · 网页管理", content="Safari 打开 https://bcp.test · 管理、测速和实时进度", style=info, script-name=BiliCDN-Panel, update-interval=60

[MITM]
hostname = %APPEND% bcp.test, upos-*.bilivideo.com, cn-*.bilivideo.com, ec-*.bilivideo.com, upos-*.akamaized.net
